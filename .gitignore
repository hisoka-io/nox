# Build artifacts
/target/

# Runtime artifacts. Most are regenerated by scripts/bootstrap-artifacts.sh, but
# the subset the heavy test suite deploys is VENDORED (committed) so CI needs no
# cross-repo clone and no credentials. See artifacts/PROVENANCE.json.
/artifacts/*
!/artifacts/PROVENANCE.json
!/artifacts/contracts/
/artifacts/contracts/*
!/artifacts/contracts/DarkPool.sol/
!/artifacts/contracts/Poseidon/
!/artifacts/contracts/verifiers/

# Circuit artifacts (nargo compile). The 7 circuits in ALLOWED_CIRCUITS are
# vendored; anything else nargo emits stays ignored.
/circuits/*
!/circuits/deposit.json
!/circuits/withdraw.json
!/circuits/transfer.json
!/circuits/join.json
!/circuits/split.json
!/circuits/public_claim.json
!/circuits/gas_payment.json

# Hardhat full artifacts (bytecode, not just ABI interfaces)
/abi/contracts/

# Database
nox_db/
data/nox_db/

# Runtime keys (generated per node)
data/p2p_id.key

# Log files
*.log

# Node modules (prover scripts)
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local config overrides
config.local.toml

# AI context (not for public repo)
no-commit/
CLAUDE.md
MEMORY.md
.claude

# Benchmark generated artifacts (data + charts)
# Scripts (run_all.sh, gen_charts.py) stay tracked - these are source code.
# Data and charts are regenerated via: ./scripts/bench/run_all.sh
# Published as GitHub Release assets for paper reproducibility.
scripts/bench/data/
scripts/bench/charts/

# Benchmark backups
scripts/bench/data_backup_*/
scripts/bench/charts_backup_*/

# Dashboard sim runtime artifacts
dashboard_sim_endpoints.json
mesh_info.jsondata/
crates/nox-node/data/
deploy/nodes.env
